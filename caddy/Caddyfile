# Reference reverse-proxy config for Pipeline's HTTP transport.
#
# ! NOT APPLIED. The LIVE routing lives in the shared /root/caddy-router, which owns
# :80/:443 and already serves pipe.casava.space with a catch-all reverse_proxy to
# pipeline:8080. This file documents the equivalent standalone block with explicit path
# matchers, so the contract is legible in one place.
#
# ! ✗ run this as a standalone Caddy on a host that already has /root/caddy-router.
# That router OWNS :80/:443 and serves Folio, Kea, Krawl, Kestrel and the harnesses. A
# second Caddy binding those ports takes TLS down for every one of them. To change how
# Pipeline is exposed, edit the block in the shared router's Caddyfile and `caddy reload`
# (zero downtime) — never `docker compose up` a competing Caddy.
#
# Routing — the same contract as Sift and Folio, so a client configured for one works
# against any of them:
#
#   /mcp                  → pipeline:8080   MCP JSON-RPC                    [Bearer]
#   /tokens/whoami        → pipeline:8080   token sanity check              [Bearer]
#   /.well-known/oauth-*  → pipeline:8080   OAuth discovery                 [public]
#   /oauth/*              → pipeline:8080   authorize · token · register    [public]
#   /health               → pipeline:8080   liveness                        [public]
#   /version              → pipeline:8080   running version                 [public]
#
# Pipeline is an MCP endpoint, not a web app — there is no browser UI. Caddy terminates
# TLS and forwards `Authorization: Bearer` untouched; the app is the SOLE auth gate.
#
# /health and /version bypass auth so a monitor can alert on a dead or stale deployment
# without holding a token. Neither echoes a token value.

{$PIPELINE_DOMAIN} {
	encode zstd gzip

	# MCP + the token check. flush_interval -1 is load-bearing, not decoration: MCP's
	# Streamable HTTP answers with SSE, and any response buffering deadlocks a long
	# tool call — the server returns 200 and the client hangs forever.
	@mcp path /mcp /mcp/* /tokens/* /health /version
	handle @mcp {
		reverse_proxy pipeline:8080 {
			flush_interval -1
			header_up Host {host}
			# Rate limiting keys on (principal, ip). Without a forwarded address every
			# client behind this router shares its IP and lands in ONE bucket, so a
			# single noisy client starves everyone else.
			#
			# ! Pipeline reads the LAST X-Forwarded-For hop, never the first. A client
			# can forge the header; a proxy appends the peer it actually saw, so the
			# forged value lands to the LEFT of the real one. Reading the first hop
			# would let a caller pick its own rate-limit key, rotate it per request,
			# and turn the limiter off while it still looked like it was working.
			# Whether this is a set (as here) or an append (`+X-Forwarded-For`), the
			# last hop is the one this router wrote — which is why that rule is safe
			# to depend on.
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			# RE jobs · image builds · long tools need generous timeouts.
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# OAuth 2.0 + PKCE for claude.ai's Custom Connector. NOT gated — claude.ai walks
	# discovery, registration and the PKCE dance anonymously and only then holds a
	# token. The bearer issued by /oauth/token gates /mcp above.
	#
	# X-Forwarded-Proto/-Host are load-bearing: Pipeline listens on plain HTTP behind
	# this router, so without them it advertises http://pipeline:8080 in its OAuth
	# metadata and sends the user's browser to an unreachable internal host.
	@oauth path /.well-known/oauth-* /oauth/*
	handle @oauth {
		reverse_proxy pipeline:8080 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# No browser UI to land on — the root and any unmatched path get a one-line hint
	# rather than a blank 200 (which reads like a live page that failed to render).
	handle {
		respond "Pipeline MCP — POST /mcp with Authorization: Bearer <token>. See /health." 200
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# GET is required: OAuth discovery and the authorize form are GETs.
		Access-Control-Allow-Origin "https://claude.ai"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, MCP-Session-Id"
	}

	log {
		output stdout
		format console
	}
}
