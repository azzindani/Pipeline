# Pipeline · runtime env. Copy to `.env` (gitignored) and fill in.
#
# ! Pipeline is NOT currently deployed publicly and no image is published. These
# settings apply to a local run (`docker compose up -d --build`). If you later
# expose it, TLS + hostname routing come from the shared /root/caddy-router —
# Pipeline never binds :80/:443 itself.

# ── Auth (mandatory) ─────────────────────────────────────────────────────────
# Pick ONE. Priority: TOKENS_FILE → TOKENS → TOKEN. With none set Pipeline
# REFUSES to start — /mcp is a remote-code-execution surface and there is no
# unauthenticated mode.
#
# Named tokens are worth the extra keystrokes: each maps to a principal, so
# revoking one holder is a single line, not a rotation for everyone.

# 1. File of named tokens: {"alice": "sk-…", "ci": "sk-…"}
#PIPELINE_TOKENS_FILE=/work/tokens.json

# 2. Inline named tokens — convenient in compose.
#PIPELINE_TOKENS=alice:sk-xxxx,ci:sk-yyyy

# 3. Single shared bearer, registered as principal "default".
#    Generate: openssl rand -hex 32
PIPELINE_TOKEN=

# ── Capability gate ──────────────────────────────────────────────────────────
# read_only (default) blocks every destructive action even with a valid token.
# Set `full` ONLY when you trust every token holder — it unlocks builds,
# deploys, commits, pushes, and container execution.
PIPELINE_REMOTE_MODE=read_only

# ── OAuth (claude.ai Custom Connector) ───────────────────────────────────────
# Lets claude.ai connect via Authorization Code + PKCE instead of a human
# pasting a static bearer. The user pastes a Pipeline token once at
# /oauth/authorize; the issued access token inherits that principal.
#
# Once deployed behind TLS, add the connector in claude.ai with the /mcp URL;
# discovery, registration, and the PKCE dance are automatic from there.
#
# Leave the secret empty to keep the client public (PKCE-only) — this is what
# claude.ai expects.
PIPELINE_OAUTH_CLIENT_ID=claude-ai
PIPELINE_OAUTH_CLIENT_SECRET=

# ── Library ──────────────────────────────────────────────────────────────────
# The durable record, browsable at /library: digests, reports, sessions,
# screenshots, RE jobs. /library is a GALLERY — cards with a kind badge, a
# pass/fail dot and a one-line summary, plus search / sort / filter. The raw
# file browser lives underneath at /library?raw=1 and at every path below it.
#
# Gated by the SAME key as /mcp — paste it once as ?token=… and it becomes a
# 30-day HttpOnly session cookie (holding a minted session token, never your API
# key). No separate login, no basic auth: a browser password popup can never be
# satisfied by an access token.
#
# ! The OAuth token store lives at <library>/.oauth — inside the served root.
# It is excluded three ways (dot-prefixed, deny-listed, containment-checked) and
# both the gallery and the browser go through the same containment rule. Point
# PIPELINE_LIBRARY_DIR somewhere and ✗ ever put a Caddy file_server on it.
#PIPELINE_LIBRARY_DIR=/work/.pipeline

# ── Limits ───────────────────────────────────────────────────────────────────
# /mcp request-body ceiling in bytes (default 8 MiB). The pre-auth OAuth
# surface is capped separately at 256 KB.
#PIPELINE_MAX_BODY_BYTES=8388608

# Token bucket, keyed on (principal, ip) — so one leaked token used from many
# hosts can't slip under the limit, and one shared NAT egress can't starve
# everyone behind it. Either at 0 disables it (right for a laptop, wrong for a
# public endpoint).
#PIPELINE_RATE_BURST=40
#PIPELINE_RATE_PER_SEC=10

# ── Misc ─────────────────────────────────────────────────────────────────────
RUST_LOG=info

# Public hostname for the shared caddy-router to route to this container.
# Unset while Pipeline is not deployed.
PIPELINE_DOMAIN=
