# Caddyfile · TLS-terminating reverse proxy in front of pipeline-mcp HTTP.
#
# Usage:
#   - Set $PIPELINE_DOMAIN to a real DNS name pointed at this VPS.
#   - Caddy auto-fetches a Let's Encrypt cert on first request.
#   - Bearer auth is enforced by Pipeline itself (PIPELINE_TOKEN env).
#   - Caddy adds standard hardening headers + access log.

{$PIPELINE_DOMAIN} {
	# Forward everything to Pipeline · no path rewrites.
	reverse_proxy pipeline:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
		# Long-running tools (RE jobs · image builds) need generous timeouts.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# Standard hardening · belt and braces.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# CORS for browser-based Claude Connectors · adjust to your origin.
		Access-Control-Allow-Origin "https://claude.ai"
		Access-Control-Allow-Methods "POST, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, MCP-Session-Id"
	}

	# Compress JSON responses.
	encode gzip zstd

	# Access log to a persistent volume.
	log {
		output file /data/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}
